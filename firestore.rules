rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catálogo de productos: cualquiera puede ver, solo administradores pueden editar/eliminar
    match /productos/{productoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Ventas y Pedidos:
    // - Clientes pueden hacer pedidos (create) sin registrarse ni crearse cuenta
    // - Nadie puede MODIFICAR (update) ni ELIMINAR (delete) a menos que esté autenticado con su cuenta
    match /ventas/{ventaId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /pedidos/{pedidoId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // 3. Regla global de seguridad para cualquier otra colección
    match /{document=**} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
